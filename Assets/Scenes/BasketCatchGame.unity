--- !u!114 &1276168468
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1276168466}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "K\u0130\u015E\u0130SEL VER\u0130LER\u0130N \u0130\u015ELENMES\u0130NE
    \u0130L\u0130\u015EK\u0130N AYDINLATMA METN\u0130 \r\n\r\nSEPHORA KOZMET\u0130K
    ANON\u0130M \u015E\u0130RKET\u0130 (\"Sephora\") veri sorumlusu s\u0131fat\u0131yla
    ki\u015Fisel verilerinizi a\u015Fa\u011F\u0131da a\xE7\u0131kland\u0131\u011F\u0131
    \xE7er\xE7evede 6698 say\u0131l\u0131 Ki\u015Fisel Verilerin Korunmas\u0131 Kanunu\u2019nda
    (\u201CKVKK\u201D) say\u0131lan \u015Fekillerde i\u015Fleyebilecektir.\r\n\r\nKi\u015Fisel
    Verilerinizin Hangi Ama\xE7la \u0130\u015Flenece\u011Fi\r\n\r\nAd-Soyad ve elektronik
    posta adres verileriniz, KVKK\u2019n\u0131n 5. ve 6. maddeleri dahilinde, Sephora'n\u0131n
    d\xFCzenledi\u011Fi \"D\xFC\u015Fenleri Yakala\" etkinli\u011Fine kat\u0131l\u0131m\u0131n\u0131z
    nedeni ile  kay\u0131t alt\u0131na al\u0131nmaktad\u0131r.  \r\n\r\nKi\u015Fisel
    Verilerinizin Kimlere ve Hangi Ama\xE7la Aktar\u0131laca\u011F\u0131\r\n\r\nToplanan
    ki\u015Fisel verileriniz; Sephora taraf\u0131ndan yukar\u0131da a\xE7\u0131k\xE7a
    belirtilmi\u015F olan ama\xE7lar\u0131n ger\xE7ekle\u015Ftirilmesi do\u011Frultusunda
    i\u015Flenecek olup herhangi bir aktar\u0131m yap\u0131lmayacakt\u0131r. \r\n\r\nKi\u015Fisel
    Verilerinizin Toplama Y\xF6ntemi ve Hukuki Sebebi \r\n\r\nKi\u015Fisel verileriniz,
    an\u0131lan etkinli\u011Fe kat\u0131l\u0131m talebiniz sonucunda sizin taraf\u0131n\u0131zdan
    iletilmesi ile elde edilecektir. \r\n\r\nKVKK\u2019n\u0131n 11. maddesinde Say\u0131lan
    Haklar\u0131 Haklar\u0131n\u0131z\r\n\r\n6698 Say\u0131l\u0131 Kanunu\u2019nun
    11. Maddesi kapsam\u0131ndaki taleplerinizi \u201CVeri Sorumlusuna Ba\u015Fvuru
    Usul ve Esaslar\u0131 Hakk\u0131nda Tebli\u011Fe\u201D g\xF6re veya https://www.sephora.com.tr/
    adresinde yer alan \u201C\u0130lgili Ki\u015Fi Ba\u015Fvuru Formu\u201Dnu doldurarak;
    kimli\u011Finizi tevsik edici belgeler ile; Suadiye Mah. Ba\u011Fdat Cad. No:
    389 Kad\u0131k\xF6y/\u0130stanbul adresine bizzat elden veya noter kanal\u0131yla,
    sephorakozmetikas@hs02.kep.tr KEP adresimize g\xFCvenli elektronik imza, mobil
    imza ya da \u015Eirketimize daha \xF6nce bildirilen ve sistemimizde kay\u0131tl\u0131
    bulunan elektronik posta adresinizi kullanmak suretiyle iletebilirsiniz."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
